# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=                    # leave blank to use OpenAI directly

# Screener uses a faster/cheaper model for email classification
SCREENER_MODEL=gpt-4o-mini

# ── Email (SMTP for sending, IMAP for reading) ─────────────
# Both SMTP and IMAP use the same Gmail account + App Password.
# Generate an App Password at: myaccount.google.com/apppasswords
FROM_EMAIL="your-email@gmail.com"
GOOGLE_APP_PASSWORD="your-google-app-password"

# SMTP — sends reply emails to customers
SMTP_EMAIL_HOST="smtp.gmail.com"
SMTP_PORT=465

# IMAP — polls inbox for new incident emails
IMAP_EMAIL_HOST="imap.gmail.com"
IMAP_PORT=993

# ── Inbox Poller ───────────────────────────────────────────
# How often the background poller checks for new emails (seconds)
POLL_INTERVAL_SECONDS=60
# LLM confidence required to classify an email as an incident (0.0–1.0)
SCREENING_THRESHOLD=0.70
# Max times to retry screening a single email after a screener error
MAX_RETRIES=3
# Shared secret used to authenticate POST /api/webhook/gmail requests
WEBHOOK_SECRET=

# ── Slack ─────────────────────────────────────────────────
# Create a Slack App at api.slack.com/apps
# Add Bot Token Scopes: chat:write, chat:write.public
# Install the app to your workspace and copy the Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# ── Jira ──────────────────────────────────────────────────
# JIRA_BASE_URL: your Atlassian instance, e.g. https://yourorg.atlassian.net
# JIRA_EMAIL: the email address associated with the API token
# JIRA_API_TOKEN: generate at id.atlassian.com/manage-profile/security/api-tokens
# JIRA_PROJECT_KEY: the project key to create issues in (e.g. INC)
# JIRA_ISSUE_TYPE: use "Task" or "Bug" for Scrum projects, "Incident" for service desk
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INC
JIRA_ISSUE_TYPE=Task

# ── Google OAuth2 (Calendar, Meet, Docs) ──────────────────
# Required only for real Google Calendar / Meet / Docs integration.
# Gmail sending and reading use App Password above — no OAuth needed.
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:8000/api/auth/google/callback as an Authorized redirect URI
# 4. Enable: Google Calendar API, Google Docs API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Token is stored here after you complete the OAuth flow at /api/auth/google
GOOGLE_TOKEN_PATH=.google_token.json
